# Host Nginx in front of the CRM Compose frontend. Render it with envsubst as shown in
# deploy/nginx/README.md; only the four CRM_*/TLS_* variables are substituted, and nginx
# variables such as $host and $http_upgrade stay as they are. Rendered with the production
# values, this file reproduces the configuration the production host runs.
#
# HSTS is deliberately off: the certificate comes from the internal CA and is renewed by
# hand, and with HSTS an expired or untrusted certificate would lock users out instead of
# showing them a warning. To enable it later, add inside the 443 server:
#   add_header Strict-Transport-Security "max-age=31536000" always;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream crm_upstream {
    server ${CRM_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CRM_DOMAIN};

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${CRM_DOMAIN};

    ssl_certificate     ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 210m;

    location /socket.io {
        proxy_pass http://crm_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://crm_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
        proxy_read_timeout 120s;
    }
}
