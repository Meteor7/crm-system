  "narrative": {
    "northStar": "研发记录册 / The R&D Notebook",
    "overview": "栖衡 QIHENG 是本次重塑选定的虚构品牌。研发记录册的索引、对齐与信息密度转译为浅色侧栏、分组导航、清晰标题和可扫描的业务记录；隐喻不画成纸张、工具或其他装饰物。\n\n本规范记录已实现的界面，延续真实业务流程、权限与路由。颜色、排版和组件以源码及桌面、移动、登录截图为依据；方向种子为 41963e97。",
    "keyCharacteristics": [
      "浅色导航与冷纸白工作区。",
      "靛蓝识别当前模块、链接与主要操作。",
      "细边框分区，数字等宽对齐，业务表格保持密度。"
    ],
    "rules": [
      {
        "name": "The Scope Rule",
        "body": "先确认组件所在作用域，再应用令牌；品牌样式不意味着每个局部尺寸都被覆盖。",
        "section": "typography"
      },
      {
        "name": "The Record Rule",
        "body": "颜色用于定位、状态与操作，状态同时保留文字。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 复用栖衡 SVG 字标与图标，保持其比例和应用入口一致。",
      "Do 在标准内容区采用正文、次要文字与说明标签的现有层级；客户 KPI 辅助说明使用 text-muted。",
      "Do 保留移动菜单、键盘焦点、表格独立滚动和减少动态效果偏好。"
    ],
    "donts": [
      "Don't 将方向稿中的圆角概念覆盖到所有组件；以本文件与实际局部样式为准。",
      "Don't 把研发记录册画成装饰性物件，或恢复旧品牌字标与页头装饰。",
      "Don't 用统一强调色取代风险、成功和警告的文字语义，或为视觉重塑改动业务流程。"
    ]
  }
}
