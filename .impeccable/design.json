      "css": ".ds-card{background:var(--crm-surface-raised,#ffffff);border:1px solid var(--crm-line,#DEE4EE);border-radius:var(--crm-radius-md,14px);box-shadow:0 1px 1px rgba(31,35,41,.02);color:var(--crm-text,#26364E);font:13px \"Segoe UI\", \"Microsoft YaHei\", \"PingFang SC\", sans-serif;}.ds-card header{padding:19px 20px 14px;}.ds-card h2{margin:3px 0 0;color:var(--crm-navy,#20324C);font-size:16px;letter-spacing:-.01em;}.ds-card p{margin:5px 0 0;color:var(--crm-text-muted,#59677D);font-size:13px;}.ds-card-body{padding:6px 20px 20px;}"
    }
